# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin chat ID for receiving support messages
# To get your ID:
# 1. For personal chat: send /start to your bot and check logs (python bot.py)
#    You'll see: Received /start from 123456789
# 2. For group: add @userinfobot to your group, send /start, it will reply with ID
# 3. For group: add your bot to group, send any message, check logs
# Note: group IDs usually start with a minus sign: -123456789
ADMIN_CHAT_ID=your_chat_id_here

# Proxy settings for bypassing blocking
# SOCKS5 proxy (e.g. from Happ VPN)
PROXY_URL=socks5://127.0.0.1:10808

# Or HTTP proxy:
# PROXY_URL=http://127.0.0.1:8080

# Or use system environment variables (HTTP_PROXY/HTTPS_PROXY)
