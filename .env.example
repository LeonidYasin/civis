# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# AI Model API Keys (optional — bot uses DeepSeek by default)
DEEPSEEK_API_KEY=your_deepseek_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Default model for coach bot (deepseek, openai, claude)
COACH_DEFAULT_MODEL=deepseek

# Database (SQLite)
DATABASE_PATH=civis.db
